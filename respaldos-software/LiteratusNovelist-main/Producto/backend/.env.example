# Variables del backend para desarrollo local.
#
# 1. Copia este archivo como .env (ese nombre está en .gitignore: NUNCA lo subas).
# 2. Completa SECRET_KEY y DATABASE_URL. Todo lo demás es opcional: si lo dejas vacío,
#    esa función queda apagada y el resto de la aplicación funciona igual.
#
# Formato: CLAVE=valor, sin comillas.

# --- Django ---
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-cualquiera
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_URL=http://localhost:4200

# --- Base de datos (elige UNA) ---
# PostgreSQL local:
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/literatus_db
# SQLite, para una prueba rápida sin instalar PostgreSQL:
# DATABASE_URL=sqlite:///db.sqlite3
# Supabase del equipo (pídela al equipo; es la base REAL, con usuarios de verdad):
# DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# CONN_MAX_AGE=60

# --- Supabase Storage: portadas, retratos y narraciones (opcional) ---
# Sin estas dos, las portadas se sirven desde backend/media/.
# SUPABASE_KEY es la service_role (Project Settings -> API), no la anon. Los comandos de
# subida también aceptan el nombre SUPABASE_SERVICE_KEY.
SUPABASE_URL=
SUPABASE_KEY=

# --- Inteligencia Artificial: chat con personajes y resúmenes (opcional) ---
# Clave gratuita en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
DEEPSEEK_API_KEY=

# --- Voz: narración de capítulos con Azure AI Speech, plan gratuito F0 (opcional) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Pagos ---
# Webpay: credenciales PÚBLICAS del ambiente de integración de Transbank (no son reales).
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_ENVIRONMENT=INTEGRACION
WEBPAY_RETURN_URL=http://localhost:8000/api/v1/finance/confirm/
# PayPal (suscripciones de /planes), modo sandbox:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PRODUCT_ID=

# --- Correo: códigos de verificación y recuperación de contraseña (opcional) ---
# Con DEBUG=True y sin correo, las cuentas nuevas quedan activas sin código.
# Gmail con Google Apps Script (gratis; guía en docs/correo-gmail-apps-script/):
APPS_SCRIPT_MAIL_URL=
APPS_SCRIPT_MAIL_SECRET=
# O Resend por SMTP:
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
