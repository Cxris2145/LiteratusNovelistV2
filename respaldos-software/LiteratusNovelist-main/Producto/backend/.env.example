# ---------------------------------------------------------------------------
# Template de variables de entorno para Literatus Novelist - Backend
# Copia este archivo a .env y rellena tus valores locales.
# NUNCA subas el archivo .env real al repositorio.
# ---------------------------------------------------------------------------

# Activar modo depuración (True solo en desarrollo local)
DEBUG=True

# Clave secreta de Django — genera una nueva en producción
SECRET_KEY=django-insecure-reemplaza-esta-clave-con-una-propia

# URL de conexión a la base de datos PostgreSQL
# Formato: postgres://<usuario>:<contraseña>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgres://postgres:tu_contraseña@localhost:5432/literatus_db

# Hosts permitidos (lista separada por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origen del frontend para CORS y enlaces de email
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Verificación de correo
# False permite login inmediato tras registro. True exige confirmar el email.
REQUIRE_EMAIL_VERIFICATION=False

# Email / recuperación de contraseña
# En desarrollo puedes dejar EMAIL_BACKEND en consola si no tienes SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@novelatus.tech
