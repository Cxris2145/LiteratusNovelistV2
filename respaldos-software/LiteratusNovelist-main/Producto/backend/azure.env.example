# Variables del backend en la máquina virtual de Azure.
#
# 1. Copia este archivo como azure.env (ese nombre está en .gitignore: NUNCA lo subas).
# 2. Pega los mismos valores que tienes hoy en Render (tu servicio -> Environment).
# 3. .\deploy-azure.ps1 los copia a la máquina (/opt/literatus/backend.env, solo lo lee root). En cada
#    publicación el backend queda con EXACTAMENTE las variables de este archivo: cualquier cambio se
#    hace aquí y se vuelve a publicar.
#
# Formato: CLAVE=valor, sin comillas y sin comentarios en la misma línea. Las claves vacías no se envían.

# --- Django ---
# La misma SECRET_KEY de Render: así nadie pierde la sesión al cambiar de servidor.
SECRET_KEY=
DEBUG=False
# La dirección de la máquina (la fija deploy-azure.ps1 con $DnsLabel).
ALLOWED_HOSTS=literatus-novelist.westus.cloudapp.azure.com
CORS_ALLOWED_ORIGINS=https://literatus-novelist-v2.vercel.app
FRONTEND_URL=https://literatus-novelist-v2.vercel.app

# --- Base de datos (la misma Supabase de Render) ---
DATABASE_URL=
CONN_MAX_AGE=60

# --- Storage de portadas y narraciones ---
SUPABASE_URL=
# La service_role (en el .env local se llama SUPABASE_SERVICE_KEY). Sin ella las narraciones se pierden al reiniciar.
SUPABASE_KEY=

# --- Inteligencia Artificial ---
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
DEEPSEEK_API_KEY=

# --- Webpay / Transbank (ambiente de PRUEBA, como en render.yaml) ---
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_ENVIRONMENT=INTEGRACION
WEBPAY_RETURN_URL=https://literatus-novelist.westus.cloudapp.azure.com/api/v1/finance/confirm/

# --- PayPal (solo si las tienes en Render) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_ENVIRONMENT=
PAYPAL_PRODUCT_ID=

# --- Voz (Azure AI Speech, el recurso literatus-voz) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus
ELEVENLABS_API_KEY=
KOKORO_API_URL=

# --- Correo ---
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
APPS_SCRIPT_MAIL_URL=
APPS_SCRIPT_MAIL_SECRET=
