*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# Entornos virtuales
.venv/
.venv312/
venv/
env/
ENV/

# Variables de entorno sensibles
.env
!.env.example

# Archivos de sistema e IDEs
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Frontend
node_modules/
.angular/
dist/
.next/
out/
.nuxt/

# Logs y Backups
*.log
logs/
backups/
**/backups/

# Archivos pesados no necesarios en repo
*.mp3
*.wav
*.epub
*.pdf
assets_to_import/
backend/media/audio_narrations/
backend/epubs_elejandria/
src/assets/voices/**/*.onnx
*.onnx
*.bin
.vercel
~$*.docx

# Base de datos y volcados pesados
*.sqlite3
*.sqlite3-journal
db.sqlite3
chapter_audit_backup*.json
backend/media/
media/