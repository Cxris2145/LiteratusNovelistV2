# ==========================================
# Literatus Novelist - .gitignore
# ==========================================

# Node / Frontend
node_modules/
**/node_modules/
.angular/
**/.angular/
dist/
**/dist/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Backend
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
**/.venv/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
**/.env
!.env.example
!**/.env.example

# Database
*.sqlite3
*.db

# Media generada en runtime (portadas/imagenes/epubs procesados) — 2+ GB, no versionar
**/backend/media/
**/backend/epubs_elejandria/
**/errores_inyeccion.txt
# Imagenes extraidas de los EPUB al reconstruir el catalogo (regenerables con import_epubs)
respaldos-software/books/*/images/

# IDEs and Editors
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
nul

# Capacitor / Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
**/android/.gradle/
**/android/build/
**/android/app/build/
