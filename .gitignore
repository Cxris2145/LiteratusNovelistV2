.env
!.env.example

# Archivos de sistema e IDEs
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Frontend (Angular / Node)
node_modules/
.angular/
.next/
out/
.nuxt/

# Logs
*.log
logs/

# Archivos temporales de Office
~$*.docx
~$*.xlsx

