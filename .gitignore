# ==========================================
# Literatus Novelist - .gitignore
# ==========================================

# Node / Frontend
node_modules/
**/node_modules/
.angular/
**/.angular/
dist/
**/dist/
.npm
*.log
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Backend
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
**/.venv/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
**/.env
!.env.example
!**/.env.example
azure.env
**/azure.env

# Database
*.sqlite3
*.db
.tmp-achievements*/
.tmp-portrait*/

# Media generada en runtime (portadas/imagenes/epubs procesados) — 2+ GB, no versionar
**/backend/media/
**/backend/epubs_elejandria/
**/errores_inyeccion.txt
# Respaldos con datos de usuarios y trabajo local de retratos.
# Los resultados finales optimizados se versionan en docs/retratos/.
/respaldos-software/respaldo-catalogo-*/
/outputs/auditoria-retratos-cuentos-2026-10-28/
/outputs/retratos-animados-2026-10-28/
/outputs/retratos-animados-2026-10-28.zip
/outputs/retratos-con-fondo-2026-10-28/
/outputs/retratos-con-fondo-2026-10-28.zip
/outputs/retratos-prioritarios-peliculas-2026-10-28/
# Imagenes extraidas de los EPUB al reconstruir el catalogo (regenerables con import_epubs)
respaldos-software/books/*/images/

# IDEs and Editors
.vscode/
**/.vscode/
.idea/
**/.idea/
.claude/
**/.claude/
.impeccable/
**/.impeccable/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
nul

# Capacitor / Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
**/android/.gradle/
**/android/build/
**/android/app/build/
".env" 
